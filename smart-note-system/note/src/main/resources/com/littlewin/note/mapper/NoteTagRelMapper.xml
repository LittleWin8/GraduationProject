<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.littlewin.note.mapper.NoteTagRelMapper">

    <select id="selectNoteIdsByTagIds" resultType="java.lang.Long">
        SELECT note_id
        FROM note_tag_rel
        WHERE tag_id IN
        <foreach collection="tagIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY note_id
        HAVING COUNT(DISTINCT tag_id) = #{tagCount}
    </select>

</mapper>