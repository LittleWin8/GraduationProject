<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.littlewin.system.mapper.SysDictTypeMapper">

    <select id="selectDictTypePageList" resultType="com.littlewin.system.domain.entity.SysDictType">
        SELECT * FROM sys_dict_type
        <where>
            <if test="query.dictName != null and query.dictName != ''">
                AND dict_name LIKE CONCAT('%', #{query.dictName}, '%')
            </if>
            <if test="query.status != null">
                AND status = #{query.status}
            </if>
        </where>
        ORDER BY dict_id ASC
    </select>

</mapper>