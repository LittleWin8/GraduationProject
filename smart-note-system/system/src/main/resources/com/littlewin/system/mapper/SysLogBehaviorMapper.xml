<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.littlewin.system.mapper.SysLogBehaviorMapper">

    <select id="selectBehaviorLogPage" resultType="com.littlewin.system.domain.vo.BehaviorLogVO">
        SELECT
            b.id,
            b.user_id,
            u.nickname,
            b.action_type,
            b.content,
            b.create_time
        FROM sys_log_behavior b
        LEFT JOIN sys_user u ON b.user_id = u.user_id
        <where>
            <if test="query.actionType != null">
                AND b.action_type = #{query.actionType}
            </if>
            <if test="query.userId != null">
                AND b.user_id = #{query.userId}
            </if>
            <if test="query.startTime != null">
                AND b.create_time &gt;= #{query.startTime}
            </if>
            <if test="query.endTime != null">
                AND b.create_time &lt;= #{query.endTime}
            </if>
        </where>
        ORDER BY b.create_time DESC
    </select>

</mapper>
