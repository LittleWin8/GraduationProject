{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^Avatar$": "@/components/Avatar/avatar.vue"
		}
	},
	"pages": [
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录",
				"navigationStyle": "custom" 
			}
		},
		{
			"path": "pages/community/community",
			"style": { 
				"navigationBarTitleText": "笔记社区",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/create/create",
			"style": { 
				"navigationBarTitleText": "发布笔记" 
			}
		},
		{
			"path": "pages/profile/profile",
			"style": { 
				"navigationBarTitleText": "个人中心",
				"enablePullDownRefresh": true
			}
		},
		{ 
			"path": "pages/tag-manage/tag-manage", 
			"style": { 
				"navigationBarTitleText": "我的标签" 
			} 
		},
		{ 
			"path": "pages/tag-notes/tag-notes", 
			"style": { 
				"navigationBarTitleText": "标签笔记" 
			} 
		},
		{
			"path": "pages/user-info/user-info",
			"style": {
				"navigationBarTitleText": ""
			}
		},
		{
			"path": "pages/note-list/note-list",
			"style": {
				"navigationBarTitleText": ""
			}
		},
		{
			"path": "pages/note-detail/note-detail",
			"style": {
				"navigationBarTitleText": "笔记详情"
			}
		},
		{
			"path": "pages/recycle-bin/recycle-bin",
			"style": {
				"navigationBarTitleText": "回收站",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/message/message",
			"style": {
				"navigationBarTitleText": "消息",
				"enablePullDownRefresh": true
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "SmartNote",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {},
	"tabBar": {
			"custom": true,
			"color": "#909399",
			"selectedColor": "#1890ff",
			"backgroundColor": "#FFFFFF",
			"borderStyle": "white",
			"list": [
				{ "pagePath": "pages/community/community", "text": "社区" },
				{ "pagePath": "pages/profile/profile", "text": "我的" }
			]
	}
}